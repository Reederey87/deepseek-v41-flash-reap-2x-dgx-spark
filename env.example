# DeepSeek-V4.1-Flash REAP-256E + NVMe Engram on this 2× DGX Spark cluster.
# Copy to .env. Do not start while another model is serving on these nodes.
#
#   cp env.example .env

# --- nodes --------------------------------------------------------------------
# Run this kit as the user that owns the HF cache and the docker socket — on
# this cluster that is `nvidia`, with the kit in /home/nvidia/dsv41.
#
# WORKER_SSH is DERIVED from WORKER_USER@WORKER_IP and is deliberately not set
# here. Do not set it to a bare hostname: `spark2` resolves from your laptop's
# ssh_config but NOT from spark1, where this script runs — the two nodes reach
# each other only over the QSFP rail. `nvidia@spark2` therefore fails with
# "Could not resolve hostname" before anything is checked. Set it only to
# override the derivation with something that resolves on the head.
WORKER_USER=nvidia
WORKER_HOME=/home/nvidia

# --- 200Gb QSFP rail 1 (PROD pins from the existing deployment here) ----------
# this cluster is 192.168.177.10/.11, both NICs enp1s0f1np1 / rocep1s0f1.
HEAD_CX7_IF=enp1s0f1np1
WORKER_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IB=rocep1s0f1
HEAD_IP=192.168.177.10
WORKER_IP=192.168.177.11
NCCL_IB_HCA=rocep1s0f1
NCCL_IB_GID_INDEX=3
NCCL_CUMEM_ENABLE=0

# --- model + image ------------------------------------------------------------
# Target: the base checkpoint with the routed-expert pool pruned 384→256 by REAP,
# nothing re-quantized (experts MXFP4, dense FP8, Engram untouched). It has a
# served receipt on exactly this hardware: 13.7 tok/s decode c=1, 1,437,437 KV
# tokens at 64K, ~94 GiB/rank weights, 47.2 GiB/rank Engram on NVMe.
#
# The repo ships shards 1-46 only; Engram shards 47-48 come from the base model.
# Point the index at the base model's Engram shards (or stage them alongside)
# before first boot — the index-driven Engram overlay handles the split, but the
# files must exist. See RESEARCH.md §11.9.
MODEL=LibertAIDAI/DeepSeek-V4.1-Flash-REAP-256E
MODEL_REVISION=main
SERVED_MODEL_NAME=deepseek-v4.1-flash-reap256
IMAGE=dsv41-reap-selfbuild
SKIP_PULL=1
PORT=8001
MASTER_PORT=29531

# --- first-boot serving shape -------------------------------------------------
TP=2
NNODES=2
# 64K is what the receipt was measured at. The 1M default is not a first-boot
# shape: KV would be 1,437,437 tokens' worth of pressure on 2x121 GiB.
MAX_MODEL_LEN=65536
# FIRST_BOOT=1 holds the conservative shape: seqs=2, eager, language-only,
# SPEC=none. Set FIRST_BOOT=0 to ramp those four deliberately once a boot has
# succeeded — the memory, GPU-exclusivity, quantization and FlashInfer gates stay
# on in both modes. The receipt's KV pool is 1,437,437 tokens at 64K, i.e. ~21.9x
# concurrency, so seqs=2 leaves most of the pool unused.
FIRST_BOOT=1
MAX_NUM_SEQS=2
# Prefill budget per step. 1024 is one 1K chunk; the community 2x-GB10 lane
# settled on 8192 for V4-Flash and the 4x lane on 16384. A cold 64K prompt needs
# 64 steps to enter at 1024 and 8 at 8192, so this is the single cheapest prefill
# lever here. Costs KV blocks, so raise it together with MIN_FREE_GIB, not alone.
MAX_NUM_BATCHED_TOKENS=8192
# Caps each running long-prefill chunk so a cold 64K prompt does not hold the
# step and stall short requests behind it (the prefill head-of-line fix).
# 0 disables it. Ignored unless chunked prefill is active.
LONG_PREFILL_TOKEN_THRESHOLD=4096
# The receipt ran --gpu-memory-utilization 0.90 against our MIN_FREE_GIB=90 gate;
# the two measure the same cliff from different sides, so stay below it.
GPU_MEM_UTIL=0.82
KV_CACHE_DTYPE=fp8
KV_CACHE_MEMORY_BYTES=4294967296
# Empty = the engine reads the checkpoint's own quantization_config (fp8/MXFP4
# for REAP-256E). Set to exl3 ONLY for an EXL3-repacked pack; start.sh refuses a
# mismatch rather than failing late in the loader.
QUANTIZATION=
LANGUAGE_MODEL_ONLY=1
ENFORCE_EAGER=1
# SPEC_METHOD is honored, not merely permitted: 'none' emits nothing, and 'dspark'
# emits `--speculative-config` with SPEC_NUM_TOKENS. Any other value fails closed.
# 'mtp' is deliberately rejected: V4.1 has no classic-MTP draft (it ships DSpark
# stages under `mtp.*`), so the engine refuses method=mtp at startup.
#
# DSpark drafts a BLOCK of tokens per round, and the engine rejects a
# `num_speculative_tokens` that is neither inside that block nor a multiple of it
# (config/speculative.py:1478-1485). This checkpoint's block is 5
# (text_config.dspark_block_size), so valid values are 1-5, 10, 15, ... and the
# default is the whole block. `check_dspark_draft` verifies the checkpoint really
# declares block 5 and really ships the `mtp.*` weights before any container
# starts.
#
# The first boot is SPEC=none. An A/B arm sets SPEC_METHOD=dspark and must be
# measured on the box: logprobs checked for NaN (this checkpoint's failure mode is
# fluent NaN carrying a healthy throughput number), and a long generation checked
# for loops if draft_sample_method=probabilistic.
SPEC_METHOD=none
SPEC_NUM_TOKENS=5
# The checkpoint's DSpark block size; check_dspark_draft refuses a mismatch.
SPEC_DSPARK_BLOCK=5
# 'greedy' (DSpark's own default) or 'probabilistic'. Probabilistic drafts in the
# target vocabulary and can reach a higher acceptance length, but upstream
# recorded it degrading into junk/loops with INFLATED acceptance rates until two
# bugfixes landed (vllm#46995). Judge it with a long-generation coherence check,
# never with a tok/s number alone.
SPEC_DRAFT_SAMPLE_METHOD=greedy
# Adaptive verification spends a profiled per-step budget on the highest-survival
# draft slots instead of always verifying the whole block, which is what makes one
# setting hold across concurrency. DSpark-only (config/speculative.py:1564).
SPEC_ADAPTIVE_VERIFICATION=0
TOKENIZER_MODE=deepseek_v41
TOOL_CALL_PARSER=deepseek_v41
REASONING_PARSER=deepseek_v41
# vLLM only activates `--tool-call-parser` behind this flag, and the failure is
# silent: a parser set without it parses nothing and reports no error. The model
# card requires both for agents. `reasoning` (not `reasoning_content`) is the
# chain-of-thought field.
ENABLE_AUTO_TOOL_CHOICE=1
# Async scheduling is a tri-state on this vLLM line: omitting the flag resolves
# to ENABLED for a generative model on the mp executor, not to "off". Async
# doubles the sliding-window reservation and so halves the *reported* KV pool
# (#47728), which is exactly the wrong trade on a KV-starved 2-Spark fit, and
# the production deployment here runs it off deliberately. Pin it explicitly so
# the default cannot drift back on. Set NO_ASYNC_SCHEDULING=0 only to measure
# the async arm.
NO_ASYNC_SCHEDULING=1
# Kernel warmups. A runtime JIT fan-out competes with the page cache for the same
# unified pool, and a 22-job fan-out reset every node of the 4x Spark V4.1 recipe.
# The 2-node recipe disables all three. Decode here is bandwidth-bound, so the
# warmups buy little; keep them off and let the persistent caches carry the win.
DISABLE_KERNEL_WARMUPS=1
DSV41_ENGRAM_DISK=1
# 1 = a failed overlay install kills the process (a `.pth` cannot raise, and a
# process running without the overlay materializes the 91 GiB tables). Set 0
# only for a debugging shell inside the container.
DSV41_ENGRAM_STRICT=1
TORCH_CUDA_ARCH_LIST=12.1a

# Refuse to start while another GPU container is running. `start.sh` inspects
# `HostConfig.DeviceRequests` on both nodes and fails closed if either node
# cannot be inspected, so a node it cannot read is a refusal and not a skip.
# This kit never stops another model for you; free both nodes yourself.
REFUSE_IF_GPU_BUSY=1

# Refuse to start below this much MemAvailable on EITHER node. On GB10 the GPU
# allocator and the page cache share one pool and the box hard-resets as
# MemAvailable approaches zero — there is no OOM kill to catch. 90 GiB is the
# floor the 4x Spark V4.1 recipe uses; do not lower it on a first boot.
MIN_FREE_GIB=90

# UCX is the RDMA transport vLLM uses under NCCL, and its memory-registration
# cache grows without bound by default: ~14 MB per request in the community
# measurement. On GB10 the GPU and host RAM are one unified pool, so that leak
# drains UMA and the host wedges silently rather than OOM-killing. Their A/B at
# 256K/5-concurrent: free UMA fell 10 -> 6 GiB and OOM-aborted in ~18 min without
# these, and stayed flat with them. Our MIN_FREE_GIB gate only checks at start,
# so it cannot catch an accumulation during serving.
UCX_MEM_MMAP_HOOK_MODE=none
UCX_RCACHE_MAX_UNRELEASED=1024

# Make the container the preferred OOM victim. On unified memory an uncapped
# overrun starves the OS instead of raising; the community recipe uses 500 so the
# kernel reclaims the engine rather than sshd.
OOM_SCORE_ADJ=500

READY_TIMEOUT=4800
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800

# Refuse to start unless the FlashInfer sparse-MLA shape check passes. This is
# ON by default. The check fails when the manager block size lands a compressed
# page on a DeepGEMM block_kv with no kernel (§11.9.15 — V4.1 needs 64, giving
# pages of 64 and 32), when the image lacks the 32-state compressed page-block
# instantiation the ratio-2 layers need (§11.9.16, added by
# overlay/patch_flashinfer_prefill_pbsx.py), or when that patch is half-applied
# or shadowed by the prebuilt AOT binary. Set to 1 only to override
# deliberately, knowing the boot is expected to fail.
SKIP_FLASHINFER_CHECK=0

# FlashInfer's JIT cache, mounted at /root/.cache/flashinfer for both ranks. The
# image masks the prebuilt AOT binary for sparse_mla_sm120 so the patched .cu is
# compiled instead (§11.9.3), which makes the compiled module a REQUIRED artifact
# rather than an optional cache. Compile it once per node with
# scripts/build_flashinfer.sh, which also writes a receipt beside the module;
# `start.sh preflight` verifies that receipt — image identity, runtime cache key,
# size and digest — on both nodes and refuses on either, because an in-engine
# nvcc build races the server for the same unified memory pool. Leave unset to
# use $CACHE_HOST/flashinfer.
FLASHINFER_CACHE_HOST=
